ay:flex}.mw-parser-output .current-events-title{flex:1}.mw-parser-output .current-events-navbar{flex:0 auto;text-align:right;white-space:nowrap}.mw-parser-output .current-events-nav{max-width:22em}.mw-parser-output .current-events-nav a{width:9em}}&lt;/style&gt;&lt;div class="current-events"&gt;
&lt;div aria-label="October 29" class="current-events-main vevent" id="2026_October_29" role="region"&gt;
&lt;div class="current-events-heading plainlinks"&gt;
&lt;div class="current-events-title" role="heading"&gt;&lt;span class="summary"&gt;October 29, 2026&lt;span style="display: none;"&gt; (&lt;span class="bday dtstart published updated itvstart"&gt;2026-10-29&lt;/span&gt;)&lt;/span&gt; (Thursday)&lt;/span&gt;
&lt;/div&gt;
&lt;ul class="current-events-navbar editlink noprint"&gt;&lt;li&gt;&lt;a class="external text" data-mw-original-href="//en.wikipedia.org/w/index.php?title=Portal:Current_events/2026_October_29&amp;amp;action=edit&amp;amp;editintro=Portal:Current_events/Edit_instructions" href="https://en.wikipedia.org/w/index.php?title=Portal:Current_events/2026_October_29&amp;amp;action=edit&amp;amp;editintro=Portal:Current_events/Edit_instructions"&gt;edit&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a class="external text" data-mw-original-href="//en.wikipedia.org/w/index.php?title=Portal:Current_events/2026_October_29&amp;amp;action=history" href="https://en.wikipedia.org/w/index.php?title=Portal:Current_events/2026_October_29&amp;amp;action=history"&gt;history&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a class="external text" data-mw-original-href="//en.wikipedia.org/w/index.php?title=Portal:Current_events/2026_October_29&amp;amp;action=watch" href="https://en.wikipedia.org/w/index.php?title=Portal:Current_events/2026_October_29&amp;amp;action=watch"&gt;watch&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;
&lt;div class="current-events-content description"&gt;
&lt;p&gt;&lt;b&gt;Armed conflicts and attacks&lt;/b&gt;
&lt;/p&gt;
&lt;ul&gt;&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/Middle_Eastern_crisis_(2023%E2%80%93present)" title="Middle Eastern crisis (2023–present)"&gt;Middle Eastern crisis&lt;/a&gt;
&lt;ul&gt;&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/Houthi%E2%80%93Saudi_conflict" title="Houthi–Saudi conflict"&gt;Houthi–Saudi conflict&lt;/a&gt;, &lt;a href="https://en.wikipedia.org/wiki/Yemeni_civil_war_(2014%E2%80%93present)" title="Yemeni civil war (2014–present)"&gt;Yemeni civil war&lt;/a&gt;
&lt;ul&gt;&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/Saudi_Arabia" title="Saudi Arabia"&gt;Saudi Arabia&lt;/a&gt; launches &lt;a href="https://en.wikipedia.org/wiki/Airstrike" title="Airstrike"&gt;airstrikes&lt;/a&gt; against two residential buildings in &lt;a href="https://en.wikipedia.org/wiki/Taiz" title="Taiz"&gt;Taiz&lt;/a&gt;, &lt;a href="https://en.wikipedia.org/wiki/Yemen" title="Yemen"&gt;Yemen&lt;/a&gt;, killing 12 civilians and wounding three more. &lt;a class="external text" href="https://english.news.cn/20261029/44a9ff9e8822451ea1c2e37ac00c3657/c.html" rel="nofollow"&gt;(Xinhua)&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/Haitian_conflict" title="Haitian conflict"&gt;Haitian conflict&lt;/a&gt;
&lt;ul&gt;&lt;li&gt;The government of &lt;a href="https://en.wikipedia.org/wiki/El_Salvador" title="El Salvador"&gt;El Salvador&lt;/a&gt; deploys 2,000 troops to &lt;a href="https://en.wikipedia.org/wiki/Haiti" title="Haiti"&gt;Haiti&lt;/a&gt; in response to the &lt;a href="https://en.wikipedia.org/wiki/2026_Croix-des-Bouquets_kidnapping" title="2026 Croix-des-Bouquets kidnapping"&gt;kidnapping&lt;/a&gt; of four Salvadoran &lt;a href="https://en.wikipedia.org/wiki/Gang_Suppression_Force" title="Gang Suppression Force"&gt;Gang Suppression Force&lt;/a&gt; members that occurred earlier in the month. &lt;a class="external text" href="https://www.bbc.com/news/articles/ck0e075n79j5o" rel="nofollow"&gt;(BBC)&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;
&lt;p&gt;&lt;b&gt;Business and economy&lt;/b&gt;
&lt;/p&gt;
&lt;ul&gt;&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/Christine_Lagarde" title="Christine Lagarde"&gt;Christine Lagarde&lt;/a&gt;, the &lt;a href="https://en.wikipedia.org/wiki/President_of_the_European_Central_Bank" title="President of the European Central Bank"&gt;president of the European Central Bank&lt;/a&gt;, resigns. She will step down from office in February 2027, eight months before her term officially ends. &lt;a class="external text" href="https://www.reuters.com/business/finance/ecb-hold-rates-investors-focus-french-bonds-lagardes-future-2026-10-28/" rel="nofollow"&gt;(Reuters)&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;American &lt;a href="https://en.wikipedia.org/wiki/Food_delivery" title="Food delivery"&gt;food delivery&lt;/a&gt; company &lt;a href="https://en.wikipedia.org/wiki/DoorDash" title="DoorDash"&gt;DoorDash&lt;/a&gt; announces an intent to close on an &lt;a href="https://en.wikipedia.org/wiki/Mergers_and_acquisitions" title="Mergers and acquisitions"&gt;acquisition&lt;/a&gt; of &lt;a href="https://en.wikipedia.org/wiki/Online_grocer" title="Online grocer"&gt;grocery delivery&lt;/a&gt; company &lt;a href="https://en.wikipedia.org/wiki/Instacart" title="Instacart"&gt;Instacart&lt;/a&gt; for &lt;a href="https://en.wikipedia.org/wiki/United_States_dollar" title="United States dollar"&gt;$&lt;/a&gt;17 billion in late 2027. &lt;a class="external text" href="https://apnews.com/article/doordash-instacart-delivery-d6f30f5d18c288eeba6babcb49260e06" rel="nofollow"&gt;(AP)&lt;/a&gt; &lt;a class="external text" href="https://www.reuters.com/legal/transactional/doordash-strikes-17-billion-deal-us-rival-instacart-bets-grocery-delivery-2026-10-29/" rel="nofollow"&gt;(Reuters)&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;
&lt;p&gt;&lt;b&gt;Disasters and accidents&lt;/b&gt;
&lt;/p&gt;
&lt;ul&gt;&lt;li&gt;An &lt;a href="https://en.wikipedia.org/wiki/Oxygen_tank" title="Oxygen tank"&gt;oxygen cylinder&lt;/a&gt; explodes inside an &lt;a href="https://en.wikipedia.org/wiki/Ambulance" title="Ambulance"&gt;ambulance&lt;/a&gt; parked at a medical facility in &lt;a href="https://en.wikipedia.org/wiki/Tharparkar" title="Tharparkar"&gt;Tharparkar&lt;/a&gt;, &lt;a href="https://en.wikipedia.org/wiki/Sindh" title="Sindh"&gt;Sindh Province&lt;/a&gt;, &lt;a href="https://en.wikipedia.org/wiki/Pakistan" title="Pakistan"&gt;Pakistan&lt;/a&gt;, killing ten people. &lt;a class="external text" href="https://apnews.com/article/pakistan-oxygen-cylinder-explosion-ambulance-sindh-f8e4e6dae32b237f1ea45e4e66f56fa5" rel="nofollow"&gt;(AP)&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Three people are killed and five more injured during the collapse of a &lt;a href="https://en.wikipedia.org/wiki/Hoodoo_(geology)" title="Hoodoo (geology)"&gt;hoodoo&lt;/a&gt; at &lt;a href="https://en.wikipedia.org/wiki/G%C3%B6reme" title="Göreme"&gt;Göreme&lt;/a&gt;'s Open Air Museum in the &lt;a href="https://en.wikipedia.org/wiki/Nev%C5%9Fehir_District" title="Nevşehir District"&gt;Nevşehir District&lt;/a&gt;, &lt;a href="https://en.wikipedia.org/wiki/Turkey" title="Turkey"&gt;Turkey&lt;/a&gt;. The suspected cause are the heavy rains of the past days. &lt;a class="external text" href="https://www.ndtv.com/world-news/2-killed-after-rock-spire-collapses-at-tourist-site-in-turkeys-cappadocia-12254667" rel="nofollow"&gt;(AFP via NDTV)&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;
&lt;p&gt;&lt;b&gt;Politics and elections&lt;/b&gt;
&lt;/p&gt;
&lt;ul&gt;&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/2027_Haitian_general_election" title="2027 Haitian general election"&gt;2027 Haitian general election&lt;/a&gt;
&lt;ul&gt;&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/Haiti" title="Haiti"&gt;Haiti&lt;/a&gt;'s &lt;a href="https://en.wikipedia.org/wiki/Provisional_Electoral_Council" title="Provisional Electoral Council"&gt;Provisional Electoral Council&lt;/a&gt; sets the &lt;a href="https://en.wikipedia.org/wiki/Two-round_system" title="Two-round system"&gt;first round&lt;/a&gt; of &lt;a href="https://en.wikipedia.org/wiki/President_of_Haiti" title="President of Haiti"&gt;presidential&lt;/a&gt; and &lt;a href="https://en.wikipedia.org/wiki/National_Assembly_(Haiti)" title="National Assembly (Haiti)"&gt;legislative&lt;/a&gt; elections for August 29, 2027, with a second round scheduled for December 5, as the country prepares for its first &lt;a href="https://en.wikipedia.org/wiki/Elections_in_Haiti" title="Elections in Haiti"&gt;national elections&lt;/a&gt; since &lt;a href="https://en.wikipedia.org/wiki/2015%E2%80%9317_Haitian_parliamentary_election" title="2015–17 Haitian parliamentary election"&gt;2017&lt;/a&gt;. &lt;a class="external text" href="https://www.rfi.fr/en/international-news/20261029-gang-plagued-haiti-sets-election-dates-for-2027" rel="nofollow"&gt;(AFP via RFI)&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/2026_Swedish_government_formation" title="2026 Swedish government formation"&gt;2026 Swedish government formation&lt;/a&gt;
&lt;ul&gt;&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/Andreas_Norl%C3%A9n" title="Andreas Norlén"&gt;Andreas Norlén&lt;/a&gt;, &lt;a href="https://en.wikipedia.org/wiki/Speaker_of_the_Riksdag" title="Speaker of the Riksdag"&gt;speaker of the Riksdag&lt;/a&gt; announces a second vote to elect the next &lt;a href="https://en.wikipedia.org/wiki/Prime_Minister_of_Sweden" title="Prime Minister of Sweden"&gt;Prime Minister&lt;/a&gt;. He proposes a coalition led by the &lt;a href="https://en.wikipedia.org/wiki/Centre_Party_(Sweden)" title="Centre Party (Sweden)"&gt;Center Party&lt;/a&gt;'s leader, &lt;a href="https://en.wikipedia.org/wiki/Elisabeth_Thand_Ringqvist" title="Elisabeth Thand Ringqvist"&gt;Thand Rigqvist&lt;/a&gt;, alongside the &lt;a class="mw-redirect" href="https://en.wikipedia.org/wiki/Social_Democratic_Party_of_Sweden" title="Social Democratic Party of Sweden"&gt;Social Democrats&lt;/a&gt;, &lt;a class="mw-redirect" href="https://en.wikipedia.org/wiki/Green_Party_of_Sweden" title="Green Party of Sweden"&gt;Greens&lt;/a&gt;, &lt;a href="https://en.wikipedia.org/wiki/Christian_Democrats_(Sweden)" title="Christian Democrats (Sweden)"&gt;Christian Democrats&lt;/a&gt;, and the &lt;a class="mw-redirect" href="https://en.wikipedia.org/wiki/Moderate_Party_(Sweden)" title="Moderate Party (Sweden)"&gt;Moderates&lt;/a&gt;. &lt;a class="external text" href="https://www.svt.se/nyheter/inrikes/senaste-nytt-om-val-2026?inlagg=0f1d3e1110abc9588f23af919fcb89ce" rel="nofollow"&gt;(SVT)&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;
&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;



