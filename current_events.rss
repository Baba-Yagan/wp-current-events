;display:flex}.mw-parser-output .current-events-title{flex:1}.mw-parser-output .current-events-navbar{flex:0 auto;text-align:right;white-space:nowrap}.mw-parser-output .current-events-nav{max-width:22em}.mw-parser-output .current-events-nav a{width:9em}}&lt;/style&gt;&lt;div class="current-events"&gt;
&lt;div aria-label="October 28" class="current-events-main vevent" id="2026_October_28" role="region"&gt;
&lt;div class="current-events-heading plainlinks"&gt;
&lt;div class="current-events-title" role="heading"&gt;&lt;span class="summary"&gt;October 28, 2026&lt;span style="display: none;"&gt; (&lt;span class="bday dtstart published updated itvstart"&gt;2026-10-28&lt;/span&gt;)&lt;/span&gt; (Wednesday)&lt;/span&gt;
&lt;/div&gt;
&lt;ul class="current-events-navbar editlink noprint"&gt;&lt;li&gt;&lt;a class="external text" data-mw-original-href="//en.wikipedia.org/w/index.php?title=Portal:Current_events/2026_October_28&amp;amp;action=edit&amp;amp;editintro=Portal:Current_events/Edit_instructions" href="https://en.wikipedia.org/w/index.php?title=Portal:Current_events/2026_October_28&amp;amp;action=edit&amp;amp;editintro=Portal:Current_events/Edit_instructions"&gt;edit&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a class="external text" data-mw-original-href="//en.wikipedia.org/w/index.php?title=Portal:Current_events/2026_October_28&amp;amp;action=history" href="https://en.wikipedia.org/w/index.php?title=Portal:Current_events/2026_October_28&amp;amp;action=history"&gt;history&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a class="external text" data-mw-original-href="//en.wikipedia.org/w/index.php?title=Portal:Current_events/2026_October_28&amp;amp;action=watch" href="https://en.wikipedia.org/w/index.php?title=Portal:Current_events/2026_October_28&amp;amp;action=watch"&gt;watch&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;
&lt;div class="current-events-content description"&gt;
&lt;p&gt;&lt;b&gt;Armed conflicts and attacks&lt;/b&gt;
&lt;/p&gt;
&lt;ul&gt;&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/Middle_Eastern_crisis_(2023%E2%80%93present)" title="Middle Eastern crisis (2023–present)"&gt;Middle Eastern crisis&lt;/a&gt;
&lt;ul&gt;&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/Houthi%E2%80%93Saudi_conflict" title="Houthi–Saudi conflict"&gt;Houthi–Saudi conflict&lt;/a&gt;, &lt;a href="https://en.wikipedia.org/wiki/Yemeni_civil_war_(2014%E2%80%93present)" title="Yemeni civil war (2014–present)"&gt;Yemeni civil war&lt;/a&gt;
&lt;ul&gt;&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/Saudi_Arabia" title="Saudi Arabia"&gt;Saudi Arabia&lt;/a&gt; launches an &lt;a href="https://en.wikipedia.org/wiki/Airstrike" title="Airstrike"&gt;airstrike&lt;/a&gt; at a market in &lt;a href="https://en.wikipedia.org/wiki/Al_Hazm,_Yemen" title="Al Hazm, Yemen"&gt;Al Hazm&lt;/a&gt;, &lt;a href="https://en.wikipedia.org/wiki/Al-Jawf_Governorate" title="Al-Jawf Governorate"&gt;Al-Jawf Governorate&lt;/a&gt;, &lt;a href="https://en.wikipedia.org/wiki/Yemen" title="Yemen"&gt;Yemen&lt;/a&gt;, killing 14 civilians and wounding ten more. &lt;a class="external text" href="https://apnews.com/article/mideast-iran-saudi-yemen-israel-palestinians-october-282026-c032db4b09725fea0f6320eec49de5d4" rel="nofollow"&gt;(AP)&lt;/a&gt; &lt;a class="external text" href="https://english.news.cn/20261028/0bff5197bf7d4bd8aef67cc902090535/c.html" rel="nofollow"&gt;(Xinhua)&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/Sudanese_civil_war_(2023%E2%80%93present)" title="Sudanese civil war (2023–present)"&gt;Sudanese civil war&lt;/a&gt;
&lt;ul&gt;&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/War_crimes_in_the_Sudanese_civil_war_(2023%E2%80%93present)" title="War crimes in the Sudanese civil war (2023–present)"&gt;War crimes in the Sudanese civil war&lt;/a&gt;
&lt;ul&gt;&lt;li&gt;Eight women and children are reported to be injured in a airstrike in &lt;a href="https://en.wikipedia.org/wiki/Kadugli" title="Kadugli"&gt;Kadugli&lt;/a&gt;, &lt;a href="https://en.wikipedia.org/wiki/South_Kordofan" title="South Kordofan"&gt;South Kordofan&lt;/a&gt;, &lt;a href="https://en.wikipedia.org/wiki/Sudan" title="Sudan"&gt;Sudan&lt;/a&gt;. &lt;a class="external text" href="https://sudantribune.com/article/320591" rel="nofollow"&gt;(&lt;i&gt;Sudan Tribune&lt;/i&gt;)&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;
&lt;p&gt;&lt;b&gt;Business and economy&lt;/b&gt;
&lt;/p&gt;
&lt;ul&gt;&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/2026_Iran_war_fuel_crisis" title="2026 Iran war fuel crisis"&gt;2026 Iran war fuel crisis&lt;/a&gt;, &lt;a href="https://en.wikipedia.org/wiki/Canada_and_the_2026_Iran_war" title="Canada and the 2026 Iran war"&gt;Canada and the 2026 Iran war&lt;/a&gt;
&lt;ul&gt;&lt;li&gt;The &lt;a href="https://en.wikipedia.org/wiki/Bank_of_Canada" title="Bank of Canada"&gt;Bank of Canada&lt;/a&gt; raises its policy &lt;a href="https://en.wikipedia.org/wiki/Interest_rate" title="Interest rate"&gt;interest rate&lt;/a&gt; by 25 basis points to 2.5%, its first increase since July 2023, citing persistent &lt;a href="https://en.wikipedia.org/wiki/Inflation" title="Inflation"&gt;inflation&lt;/a&gt; driven partly by higher &lt;a href="https://en.wikipedia.org/wiki/Petroleum_industry_in_Canada" title="Petroleum industry in Canada"&gt;oil&lt;/a&gt; and &lt;a href="https://en.wikipedia.org/wiki/Natural_gas_in_Canada" title="Natural gas in Canada"&gt;gasoline&lt;/a&gt; prices linked to the &lt;a href="https://en.wikipedia.org/wiki/2026_Iran_war" title="2026 Iran war"&gt;Iran war&lt;/a&gt;. &lt;a class="external text" href="https://www.afp.com/en/canada-hikes-rates-contain-oil-price-surge-caused-iran-war" rel="nofollow"&gt;(AFP)&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/Jio_Platforms" title="Jio Platforms"&gt;Jio Platforms&lt;/a&gt; raises &lt;a class="mw-redirect" href="https://en.wikipedia.org/wiki/US$" title="US$"&gt;US$&lt;/a&gt;3.2 billion in &lt;a href="https://en.wikipedia.org/wiki/India" title="India"&gt;India&lt;/a&gt;'s largest-ever &lt;a href="https://en.wikipedia.org/wiki/Initial_public_offering" title="Initial public offering"&gt;initial public offering&lt;/a&gt; (IPO), attracting about $77 billion in bids and becoming the country's most-subscribed IPO before its &lt;a href="https://en.wikipedia.org/wiki/Stock_market" title="Stock market"&gt;stock-market&lt;/a&gt; debut in &lt;a href="https://en.wikipedia.org/wiki/Bombay_Stock_Exchange" title="Bombay Stock Exchange"&gt;Mumbai&lt;/a&gt;. &lt;a class="external text" href="https://www.france24.com/en/live-news/20261028-billionaire-ambani-s-jio-to-debut-after-record-india-ipo" rel="nofollow"&gt;(AFP via France 24)&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;
&lt;p&gt;&lt;b&gt;Disasters and accidents&lt;/b&gt;
&lt;/p&gt;
&lt;ul&gt;&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/2026_Toledo_train_collision" title="2026 Toledo train collision"&gt;2026 Toledo train collision&lt;/a&gt;
&lt;ul&gt;&lt;li&gt;At least 69 people are killed and 179 injured during a collision between two &lt;a href="https://en.wikipedia.org/wiki/High-speed_rail" title="High-speed rail"&gt;high speed trains&lt;/a&gt; carrying a total of 544 passengers between &lt;a href="https://en.wikipedia.org/wiki/Los_Y%C3%A9benes" title="Los Yébenes"&gt;Los Yébenes&lt;/a&gt; and &lt;a href="https://en.wikipedia.org/wiki/Urda,_Toledo" title="Urda, Toledo"&gt;Urda&lt;/a&gt;, in the &lt;a href="https://en.wikipedia.org/wiki/Province_of_Toledo" title="Province of Toledo"&gt;Province of Toledo&lt;/a&gt;, &lt;a href="https://en.wikipedia.org/wiki/Spain" title="Spain"&gt;Spain&lt;/a&gt;. &lt;a class="external text" href="https://news.sky.com/story/spain-train-crash-latest-numerous-injuries-reported-after-high-speed-collision-on-madrid-andalusia-line-13604696" rel="nofollow"&gt;(Sky News)&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/2026_North_Indian_Ocean_cyclone_season" title="2026 North Indian Ocean cyclone season"&gt;2026 North Indian Ocean cyclone season&lt;/a&gt;
&lt;ul&gt;&lt;li&gt;At least three people are killed as &lt;a href="https://en.wikipedia.org/wiki/Cyclone_Arnab" title="Cyclone Arnab"&gt;Cyclone Arnab&lt;/a&gt; makes &lt;a href="https://en.wikipedia.org/wiki/Landfall" title="Landfall"&gt;landfall&lt;/a&gt; in &lt;a href="https://en.wikipedia.org/wiki/Andhra_Pradesh" title="Andhra Pradesh"&gt;Andhra Pradesh&lt;/a&gt;, &lt;a href="https://en.wikipedia.org/wiki/India" title="India"&gt;India&lt;/a&gt;. &lt;a class="external text" href="https://www.dnaindia.com/india/report-cyclone-arnab-3-dead-houses-damaged-as-strong-winds-lash-andhra-pradesh-3223161" rel="nofollow"&gt;(&lt;i&gt;DNA&lt;/i&gt;)&lt;/a&gt; &lt;a class="external text" href="https://www.reuters.com/business/environment/cyclone-arnab-begins-making-landfall-indias-andhra-pradesh-state-2026-10-27/" rel="nofollow"&gt;(Reuters)&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;
&lt;p&gt;&lt;b&gt;International relations&lt;/b&gt;
&lt;/p&gt;
&lt;ul&gt;&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/Rwanda%E2%80%93United_States_relations" title="Rwanda–United States relations"&gt;Rwanda–United States relations&lt;/a&gt;, &lt;a href="https://en.wikipedia.org/wiki/Democratic_Republic_of_the_Congo%E2%80%93Rwanda_conflict_(2022%E2%80%93present)" title="Democratic Republic of the Congo–Rwanda conflict (2022–present)"&gt;Democratic Republic of the Congo–Rwanda conflict&lt;/a&gt;
&lt;ul&gt;&lt;li&gt;The &lt;a href="https://en.wikipedia.org/wiki/United_States" title="United States"&gt;United States&lt;/a&gt; imposes &lt;a href="https://en.wikipedia.org/wiki/United_States_government_sanctions" title="United States government sanctions"&gt;sanctions&lt;/a&gt; on the &lt;a href="https://en.wikipedia.org/wiki/Rwanda" title="Rwanda"&gt;Rwandan&lt;/a&gt; &lt;a href="https://en.wikipedia.org/wiki/Ministry_of_Defence_(Rwanda)" title="Ministry of Defence (Rwanda)"&gt;ministry of defence&lt;/a&gt; over its role in the &lt;a href="https://en.wikipedia.org/wiki/M23_campaign_(2022%E2%80%93present)" title="M23 campaign (2022–present)"&gt;conflict&lt;/a&gt; in eastern &lt;a href="https://en.wikipedia.org/wiki/Democratic_Republic_of_the_Congo" title="Democratic Republic of the Congo"&gt;Democratic Republic of the Congo&lt;/a&gt;, alleging that Rwanda is backing the &lt;a href="https://en.wikipedia.org/wiki/March_23_Movement" title="March 23 Movement"&gt;M23 rebels&lt;/a&gt; to fight against &lt;a href="https://en.wikipedia.org/wiki/Armed_Forces_of_the_Democratic_Republic_of_the_Congo" title="Armed Forces of the Democratic Republic of the Congo"&gt;Congolese forces&lt;/a&gt;. &lt;a class="external text" href="https://www.reuters.com/world/africa/us-imposes-sanctions-rwandas-ministry-defense-2026-10-28/" rel="nofollow"&gt;(Reuters)&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/United_States_embargo_against_Cuba" title="United States embargo against Cuba"&gt;United States embargo against Cuba&lt;/a&gt;
&lt;ul&gt;&lt;li&gt;The &lt;a href="https://en.wikipedia.org/wiki/United_Nations_General_Assembly" title="United Nations General Assembly"&gt;United Nations General Assembly&lt;/a&gt; adopts a &lt;a href="https://en.wikipedia.org/wiki/United_Nations_resolution" title="United Nations resolution"&gt;resolution&lt;/a&gt; calling for an end to the American &lt;a class="mw-redirect" href="https://en.wikipedia.org/wiki/Embargo" title="Embargo"&gt;embargo&lt;/a&gt; against &lt;a href="https://en.wikipedia.org/wiki/Cuba" title="Cuba"&gt;Cuba&lt;/a&gt; by 130 votes to 17, with 25 abstentions, the measure's lowest support since 1995. &lt;a class="external text" href="https://www.france24.com/en/live-news/20261028-cuba-wins-un-vote-against-us-embargo-with-weakest-backing-in-30-years" rel="nofollow"&gt;(AFP via France 24)&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;
&lt;p&gt;&lt;b&gt;Law and crime&lt;/b&gt;
&lt;/p&gt;
&lt;ul&gt;&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/List_of_attacks_against_Israeli_diplomatic_missions_and_personnel" title="List of attacks against Israeli diplomatic missions and personnel"&gt;Attacks on Israeli embassies&lt;/a&gt;
&lt;ul&gt;&lt;li&gt;A youth armed with two knives wounds a &lt;a href="https://en.wikipedia.org/wiki/Police_of_Serbia" title="Police of Serbia"&gt;police officer&lt;/a&gt; outside the &lt;a href="https://en.wikipedia.org/wiki/List_of_diplomatic_missions_of_Israel#Europe" title="List of diplomatic missions of Israel"&gt;Israeli embassy&lt;/a&gt; in &lt;a href="https://en.wikipedia.org/wiki/Belgrade" title="Belgrade"&gt;Belgrade&lt;/a&gt;, &lt;a href="https://en.wikipedia.org/wiki/Serbia" title="Serbia"&gt;Serbia&lt;/a&gt;, before being shot and killed. &lt;a class="external text" href="https://www.reuters.com/world/policeman-kills-knife-attacker-outside-israels-embassy-serbia-2026-10-28/" rel="nofollow"&gt;(Reuters)&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;
&lt;li&gt;British &lt;a href="https://en.wikipedia.org/wiki/Far-right_politics_in_the_United_Kingdom" title="Far-right politics in the United Kingdom"&gt;far-right&lt;/a&gt; activist &lt;a href="https://en.wikipedia.org/wiki/Tommy_Robinson" title="Tommy Robinson"&gt;Tommy Robinson&lt;/a&gt; is convicted of &lt;a href="https://en.wikipedia.org/wiki/Harassment" title="Harassment"&gt;harassing&lt;/a&gt; two &lt;a href="https://en.wikipedia.org/wiki/Mass_media_in_the_United_Kingdom" title="Mass media in the United Kingdom"&gt;journalists&lt;/a&gt; and causing them to fear violence. &lt;a class="external text" href="https://www.bbc.com/news/articles/cq2d6z36pp53o" rel="nofollow"&gt;(BBC News)&lt;/a&gt; &lt;a class="external text" href="https://www.rte.ie/news/world/2026/1028/1597108-tommy-robinson-court/" rel="nofollow"&gt;(RTÉ)&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;
&lt;p&gt;&lt;b&gt;Politics and elections&lt;/b&gt;
&lt;/p&gt;
&lt;ul&gt;&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/2026_Brazilian_general_election" title="2026 Brazilian general election"&gt;2026 Brazilian general election&lt;/a&gt;
&lt;ul&gt;&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/Federal_Senate_(Brazil)" title="Federal Senate (Brazil)"&gt;Brazilian senator&lt;/a&gt; &lt;a href="https://en.wikipedia.org/wiki/Fl%C3%A1vio_Bolsonaro" title="Flávio Bolsonaro"&gt;Flávio Bolsonaro&lt;/a&gt;, following his escape from Brazil and arrival in &lt;a href="https://en.wikipedia.org/wiki/Florida" title="Florida"&gt;Florida&lt;/a&gt;, &lt;a href="https://en.wikipedia.org/wiki/United_States" title="United States"&gt;United States&lt;/a&gt;, after the general election, proclaims himself the "rightful" president-elect of Brazil. &lt;a class="external text" href="https://www.theguardian.com/world/2026/oct/28/flavio-bolsonaro-miami-us-fleeing-brazilian-election-defeat" rel="nofollow"&gt;(&lt;i&gt;The Guardian&lt;/i&gt;)&lt;/a&gt; &lt;a class="external text" href="https://www.reuters.com/world/americas/flavio-bolsonaro-expected-land-miami-shortly-after-trump-offers-brazil-exit-2026-10-28/" rel="nofollow"&gt;(Reuters)&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/President_of_Brazil" title="President of Brazil"&gt;Brazilian president&lt;/a&gt; &lt;a href="https://en.wikipedia.org/wiki/Luiz_In%C3%A1cio_Lula_da_Silva" title="Luiz Inácio Lula da Silva"&gt;Luiz Inácio Lula da Silva&lt;/a&gt; responds by accusing the &lt;a class="mw-redirect" href="https://en.wikipedia.org/wiki/U.S._government" title="U.S. government"&gt;U.S. government&lt;/a&gt; of colluding with Bolsonaro to install him as president. &lt;a class="external text" href="https://www.reuters.com/world/americas/flavio-bolsonaro-expected-land-miami-shortly-after-trump-offers-brazil-exit-2026-10-28/" rel="nofollow"&gt;(Reuters)&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/2026_Israeli_legislative_election" title="2026 Israeli legislative election"&gt;2026 Israeli legislative election&lt;/a&gt;
&lt;ul&gt;&lt;li&gt;Incumbent &lt;a href="https://en.wikipedia.org/wiki/Prime_Minister_of_Israel" title="Prime Minister of Israel"&gt;prime minister&lt;/a&gt; &lt;a href="https://en.wikipedia.org/wiki/Benjamin_Netanyahu" title="Benjamin Netanyahu"&gt;Benjamin Netanyahu&lt;/a&gt; and his &lt;a href="https://en.wikipedia.org/wiki/Likud" title="Likud"&gt;Likud&lt;/a&gt; party-led governing coalition wins a plurality of seats in the &lt;a href="https://en.wikipedia.org/wiki/Knesset" title="Knesset"&gt;Knesset&lt;/a&gt;, though no alliance wins a majority, leaving &lt;a href="https://en.wikipedia.org/wiki/Government_formation" title="Government formation"&gt;government formation&lt;/a&gt; unclear. &lt;a class="external text" href="https://www.cbsnews.com/news/israel-election-exit-polls-stalemate/" rel="nofollow"&gt;(CBS News)&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;
&lt;p&gt;&lt;b&gt;Sports&lt;/b&gt;
&lt;/p&gt;
&lt;ul&gt;&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/2026_Japan_Series" title="2026 Japan Series"&gt;2026 Japan Series&lt;/a&gt;
&lt;ul&gt;&lt;li&gt;In &lt;a href="https://en.wikipedia.org/wiki/Baseball" title="Baseball"&gt;baseball&lt;/a&gt;, the &lt;a href="https://en.wikipedia.org/wiki/Fukuoka_SoftBank_Hawks" title="Fukuoka SoftBank Hawks"&gt;Fukuoka SoftBank Hawks&lt;/a&gt; defeat the &lt;a href="https://en.wikipedia.org/wiki/Yokohama_DeNA_BayStars" title="Yokohama DeNA BayStars"&gt;Yokohama DeNA BayStars&lt;/a&gt; in four games to win their 13th &lt;a href="https://en.wikipedia.org/wiki/Japan_Series" title="Japan Series"&gt;Japan Series&lt;/a&gt; championship. &lt;a class="external text" href="https://english.kyodonews.net/articles/-/89710" rel="nofollow"&gt;(Kyodo News)&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href="https://en.wikipedia.org/wiki/2026_World_Series" title="2026 World Series"&gt;2026 World Series&lt;/a&gt;
&lt;ul&gt;&lt;li&gt;In &lt;a href="https://en.wikipedia.org/wiki/Major_League_Baseball" title="Major League Baseball"&gt;Major League Baseball&lt;/a&gt;, the &lt;a href="https://en.wikipedia.org/wiki/Milwaukee_Brewers" title="Milwaukee Brewers"&gt;Milwaukee Brewers&lt;/a&gt; defeat the &lt;a href="https://en.wikipedia.org/wiki/Tampa_Bay_Rays" title="Tampa Bay Rays"&gt;Tampa Bay Rays&lt;/a&gt; in five games to win their first &lt;a href="https://en.wikipedia.org/wiki/World_Series" title="World Series"&gt;World Series&lt;/a&gt; championship in &lt;a href="https://en.wikipedia.org/wiki/List_of_Milwaukee_Brewers_seasons" title="List of Milwaukee Brewers seasons"&gt;franchise history&lt;/a&gt;. &lt;a class="external text" href="https://www.nbcnews.com/sports/mlb/milwaukee-brewers-tampa-bay-rays-world-series-game-5-result-rcna605974" rel="nofollow"&gt;(NBC News)&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;
&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;



